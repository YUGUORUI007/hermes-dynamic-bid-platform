BID_PLATFORM_ENV=production
BID_PLATFORM_SECRET_KEY=<generate-a-long-random-secret>
BID_PLATFORM_ADMIN_USERNAME=admin
BID_PLATFORM_ADMIN_PASSWORD=<set-a-unique-strong-password>
# required: login and role permissions; open: trusted internal users can only browse the workspace.
BID_PLATFORM_AUTH_MODE=required
BID_PLATFORM_PUBLIC_BASE_URL=https://bid.example.com
BID_PLATFORM_ENABLE_LEGACY_AI=0
BID_PLATFORM_INSTANCE_DIR=/data/bid-platform/instance
BID_PLATFORM_STORAGE_DIR=/data/bid-platform/storage
BID_PLATFORM_DATABASE_URL=sqlite:////data/bid-platform/instance/platform.db
